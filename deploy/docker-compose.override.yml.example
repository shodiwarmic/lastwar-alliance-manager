# Dev overrides for the compose stack. Compose never reads a ".example" file, and it
# resolves relative volume paths against the compose file's own directory — so copy this
# to the repo ROOT as docker-compose.override.yml, where Compose picks it up automatically:
#
#     cp deploy/docker-compose.override.yml.example docker-compose.override.yml
#
# The base file publishes 8080 and 9980 on 127.0.0.1 only. To reach the dev stack from
# another machine (or from Windows via the WSL LAN IP), set BIND_ADDR=0.0.0.0 in .env —
# not a `ports:` entry here, which would collide with the base file's binding.

services:
  alliance-manager:
    # Builds from source and names the result itself, so APP_VERSION in .env is
    # ignored here — a dev stack is deliberately not pinned to a release.
    build: .
    image: lastwar-alliance-manager:dev
    environment:
      - PRODUCTION=false
      - HTTPS=false
      # Replace these with your actual WSL or Windows LAN IP
      - APP_DOMAIN=192.168.1.X:8080
      - COLLABORA_DOMAIN=192.168.1.X:9980
    volumes:
      # Dev hot-reload: serve UI from the host instead of the baked-in image copy.
      # templates are ParseFiles'd per request and static is served via http.Dir,
      # so edits to .html / .css / .js / .svg show on a browser refresh — no rebuild,
      # no container restart. (Go code changes still need `docker compose up -d --build`.)
      - ./templates:/app/templates:ro
      - ./static:/app/static:ro

  collabora:
    environment:
      - aliasgroup1=http://.*:8080
      - extra_params=--o:ssl.enable=false --o:ssl.termination=false
