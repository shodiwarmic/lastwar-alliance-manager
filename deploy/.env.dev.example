# deploy/.env.dev.example — the dev stack's own .env entries, on top of .env.example.
#
# A production .env must NOT carry these. Build the dev stack's .env from both files, as
# CLAUDE.md → "Running locally" describes (that is the one place that says how):
#
#     { grep -vE '^(PRODUCTION|HTTPS)=' .env.example; cat deploy/.env.dev.example; } > .env
#
# then set SESSION_KEY and CREDENTIAL_ENCRYPTION_KEY (openssl rand -hex 32 for each). The
# dev override (deploy/docker-compose.override.yml.example) supplies the rest: the source
# build, the LAN addresses, and Collabora's plain-HTTP settings.

# docker-compose.yml publishes 8080 and 9980 on 127.0.0.1 only, so without this the dev stack
# is unreachable at the WSL LAN IP from Windows or a phone, and so is Collabora. It has to be
# here: compose interpolation reads .env, and an override's `environment:` block does not
# reach the `ports:` line.
BIND_ADDR=0.0.0.0

# The Admin page shows this beside the image version. A dev stack is a git checkout, not a
# release download, so without it the page reads "not yet migrated".
HOST_FILES_VERSION=dev

# Plain HTTP on a LAN: secure cookies would never be sent back.
PRODUCTION=false
HTTPS=false
