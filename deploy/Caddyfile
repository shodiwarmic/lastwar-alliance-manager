# alliance-manager caddyfile rev 1
#
# The ONE Caddyfile. scripts/install.sh renders it to /etc/caddy/Caddyfile, and
# scripts/manage.sh update re-renders it whenever the revision on the first line is higher
# than the deployed file's. So: bump the revision with every change to this file, or no
# existing install will ever receive the change. The rendered file keeps this first line,
# which is how the next update reads what it has.
#
# The two placeholders (APP_DOMAIN and COLLABORA_DOMAIN, each wrapped in double underscores)
# are replaced from the same keys in the install's .env — render_caddyfile in
# scripts/lib/common.sh; docs/DEPLOYMENT.md shows the one-line equivalent for rendering by
# hand. A re-render overwrites hand edits to /etc/caddy/Caddyfile, keeping a dated backup.
#
# There is deliberately no www.<domain> redirect block: the documented DNS setup is two
# records, and a site block for a name with no record makes Caddy retry a certificate it can
# never get, forever, in its log. If your DNS has a www record, add the block by hand:
#
#   www.app.example.org {
#       redir https://app.example.org{uri} permanent
#   }
#
# Both upstreams are 127.0.0.1 rather than localhost: docker-compose.yml publishes the app and
# Collabora on the IPv4 loopback only, and "localhost" may resolve to ::1 first.

__APP_DOMAIN__ {
    reverse_proxy 127.0.0.1:8080
    encode gzip
    header {
        X-Content-Type-Options "nosniff"
        # SAMEORIGIN, not DENY: the Collabora iframe loads inside this app's own pages.
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # frame-src / connect-src let the Collabora editor load and open its WebSocket.
        # img-src carries the game CDN hosts that LastRank avatars are hotlinked from.
        Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data: https://lastwar-cdn.akamaized.net https://lastwar-cdn.lastwarapp.net; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://__COLLABORA_DOMAIN__; frame-src https://__COLLABORA_DOMAIN__; frame-ancestors 'none';"
        -Server
    }
    log {
        output file /var/log/caddy/lastwar-access.log {
            roll_size 100mb
            roll_keep 10
            roll_keep_for 720h
        }
        format json
    }
}

__COLLABORA_DOMAIN__ {
    encode gzip
    reverse_proxy 127.0.0.1:9980
    header {
        X-Content-Type-Options "nosniff"
        # No X-Frame-Options here: the editor MUST be embeddable — by the app, and only by it.
        Content-Security-Policy "frame-ancestors https://__APP_DOMAIN__"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }
}
