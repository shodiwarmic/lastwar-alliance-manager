#!/bin/bash
# sqlite3 stub: understands `sqlite3 DB ".backup 'DEST'"` by copying DB to DEST, and answers a
# query on goose_db_version with the contents of DB.schema (the schema maximum a test gave
# that database), which a backup carries along.
printf '%s\n' "sqlite3 $*" >> "$STUB_LOG"
if [ -x "$STUB_RESPONSES/sqlite3" ]; then
    exec "$STUB_RESPONSES/sqlite3" "$@"
fi
db=$1
dest=$(printf '%s' "${2:-}" | sed -n "s/^\.backup '\(.*\)'\$/\1/p")
if [ -n "$dest" ]; then
    cp "$db" "$dest"
    if [ -f "$db.schema" ]; then
        cp "$db.schema" "$dest.schema"
    fi
fi
# A database file a test wrote may say its own schema (a line schema=N) and whether it is
# corrupt; a plain copy of it carries both.
case ${2:-} in
    *goose_db_version*)
        if [ -f "$db.schema" ]; then cat "$db.schema"; else sed -n 's/^schema=//p' "$db" 2>/dev/null; fi ;;
    *integrity_check*)
        if grep -q '^corrupt' "$db" 2>/dev/null; then echo "*** in database main ***"; else echo ok; fi ;;
esac
exit 0
