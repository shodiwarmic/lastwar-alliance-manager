# ==========================================
# Last War Alliance Manager - Environment Setup
# ==========================================

# --- Core Security ---
# Must be a 64-character hex string. 
# Generate via: openssl rand -hex 32
SESSION_KEY=your_64_character_hex_string_here

# 32-byte hex-encoded string for AES-GCM encryption of external API credentials.
# Generate one using: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=your_32_byte_hex_string_here

# --- Storage Paths (Docker Defaults) ---
# When running in Docker, these map to the internal container paths.
DATABASE_PATH=/app/data/alliance.db
STORAGE_PATH=/app/uploads

# --- Environment Flags ---
# Set both to 'true' in production to enforce secure, encrypted cookies.
# Set to 'false' for local HTTP testing.
PRODUCTION=true
HTTPS=true

# --- Domains & Routing ---
# The domains where your application and document server live.
# Note: Do not include http:// or https:// here.
APP_DOMAIN=app.example.com
COLLABORA_DOMAIN=collabora.example.com

# --- Security (CSRF) ---
# A comma-separated list of exact domains/IPs allowed to submit forms.
# MUST include the port if accessing via a non-standard port locally.
TRUSTED_ORIGINS=app.example.com, localhost:8080, 127.0.0.1:8080

# --- Client IP (rate limiting) ---
# How many reverse proxies sit in front of the app. Each one appends to
# X-Forwarded-For, and the app reads the client address that many entries from
# the RIGHT; everything further left was sent by the client and is ignored.
# Unset means 1 when PRODUCTION=true (behind the Caddy install.sh sets up) and 0
# otherwise (the header is ignored and the TCP peer is used). Set 2 behind a CDN
# or load balancer that itself sits in front of Caddy/nginx. A wrong 0 behind a
# proxy puts the whole alliance in one login rate-limit bucket.
# TRUSTED_PROXY_COUNT=1

# --- Published ports (read by docker-compose.yml, not by the app) ---
# The app (8080) and Collabora (9980) are published on 127.0.0.1 only, so the
# reverse proxy on this host is the only way in. For a LAN or dev install with
# no proxy, open them to every interface:
# BIND_ADDR=0.0.0.0

# --- Release Pin (optional) ---
# Which published image this install runs. scripts/install.sh and
# scripts/manage.sh update write the release tag here for you, together with the
# host files of the same release — so pin or roll back with
#   ./scripts/manage.sh update --version v2.1.0
# rather than by editing this line. Unset means 'latest', which is the latest
# RELEASE ('edge' is built from main and has no host files to match).
# Releases: https://github.com/shodiwarmic/lastwar-alliance-manager/releases
# APP_VERSION=latest

# --- Host files release (script-owned — do not edit) ---
# The release the compose files, scripts and Caddyfile template in this
# directory came from. scripts/install.sh and scripts/manage.sh write it, after
# every other step of an update has succeeded; the Admin page shows it beside
# the image version. Absent on an install from before v2.0.0 that has not been
# migrated yet (git pull, then ./scripts/manage.sh migrate).
# HOST_FILES_VERSION=v2.0.0

# --- OCR Backend (optional) ---
# 'cloud' (default) uses Google Cloud Vision; 'local' runs the bundled PaddleOCR
# sidecar instead, with no external dependencies. Selecting 'local' also requires
# COMPOSE_FILE=docker-compose.yml:docker-compose.local-ocr.yml — scripts/install.sh
# sets both for you if you opt in. See docs/IMAGE_RECOGNITION.md.
# OCR_BACKEND_MODE=cloud

# --- OCR Request Archival (optional, off by default) ---
# Retains uploaded screenshots + the parsed OCR response for improving OCR /
# diagnosing mistakes. The destination (none/gcp/local/both) and GCS bucket are
# configured in Admin → Security, NOT here. These two vars only set up the
# LOCAL-disk destination's prerequisites.
#
# Host path for local-disk archival. Empty = local archival option disabled.
# DOCKER WARNING: this MUST be inside a mounted volume — the default
# /app/data/ocr-archive lives under the existing ./data mount. A path NOT mounted
# (e.g. /var/log/archives) writes to the container's ephemeral layer and is LOST
# on the next recreate/update. To relocate, bind-mount your disk at the host's
# ./data/ocr-archive instead of changing this path.
OCR_ARCHIVE_DIR=
# Days to retain local archives before the in-app janitor prunes them (default 7;
# local archives live on the host disk). Negative disables in-app pruning (manage
# cleanup yourself — see docs/DEPLOYMENT.md). Ignored when OCR_ARCHIVE_DIR is unset.
OCR_ARCHIVE_RETENTION_DAYS=7
