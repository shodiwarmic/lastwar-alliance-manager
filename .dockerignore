# Git
.git
.gitignore

# Runtime data — bind-mounted at runtime, never belongs in the image. Also keeps
# the build context from choking on archive dirs the host user can't read.
data/
uploads/

# Database files (will be stored in volume)
*.db
*.db-shm
*.db-wal

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Fly.io
fly.toml

# Documentation, CI and the host scripts' tests -- nothing the image needs, and listing
# them keeps a doc or test change from invalidating the builder's `COPY . .` layer.
README.md
.github
docs/
tests/
